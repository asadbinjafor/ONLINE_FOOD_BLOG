# Set these in the shell locally or in Render Environment. Never commit real values.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.example.supabase.co:5432/postgres?sslmode=require
# Alternative to DATABASE_URL:
# DB_HOST=db.example.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=replace-me
# DB_SSLMODE=require
BASE_URL=
REMEMBER_SECRET=generate-a-long-random-value
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=food-blog
